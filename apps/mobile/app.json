{
  "expo": {
    "name": "Our Budget",
    "slug": "household-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.household.ourbudget",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your household budget server on your computer.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.household.ourbudget"
    },
    "plugins": ["expo-sqlite", "expo-secure-store", "./plugins/withLocalNetwork"],
    "extra": {
      "eas": {
        "projectId": "83b19642-8fa1-4782-b79b-6280641e96b5"
      }
    }
  }
}
